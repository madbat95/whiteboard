# Backend gateway (REST + WS), called cross-origin directly — see contract §4.
NEXT_PUBLIC_API_URL=http://localhost:4000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Shared HS256 secret — MUST match JWT_SECRET on /server so the backend can
# verify the JWT issued here (contract §4 "Auth transport for WS").
NEXTAUTH_SECRET=dev-shared-secret-change-me
