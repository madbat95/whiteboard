# Postgres connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whiteboard?schema=public"

# Redis connection (socket.io adapter + presence store)
REDIS_URL="redis://localhost:6379"

# Shared HS256 secret — MUST match NextAuth's secret on the frontend
# (contract.ts §4: "Auth transport for WS")
JWT_SECRET="change-me-in-production"

# CORS: origin(s) allowed to call the REST API / connect the socket
FRONTEND_ORIGIN="http://localhost:3000"

# Port the Nest HTTP + WS server listens on
PORT=4000
